name: Compare Financial CF

on:
  workflow_dispatch:
  schedule:
    - cron: '0 1 * * *'  # 毎日定刻実行（手動実行も可）

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests matplotlib japanize-matplotlib

      - name: Step 1 - Generate Compare Charts
        env:
          EDINET_API_KEY: ${{ secrets.EDINET_API_KEY }}
          NOTION_API_KEY: ${{ secrets.NOTION_API_KEY }}
          NOTION_DATABASE_ID: ${{ secrets.NOTION_DATABASE_ID }}
          SYNC_MODE: "GENERATE"
        run: python compare_cf.py

      - name: Step 2 - Commit & Push Images to GitHub
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git pull origin main || true
          git add images/
          if git diff --staged --quiet; then
            echo "No changes to commit"
          else
            git commit -m "Add comparison chart images [skip ci]"
            git push origin main
          fi

      - name: Step 3 - Sync Images to Notion
        env:
          NOTION_API_KEY: ${{ secrets.NOTION_API_KEY }}
          NOTION_DATABASE_ID: ${{ secrets.NOTION_DATABASE_ID }}
          SYNC_MODE: "NOTION_SYNC"
        run: python compare_cf.py
